.centered {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

#Background {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);

    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.panel {
    position: absolute;
    background-color: rgb(168, 168, 168);
    border-radius: 45px;
    padding: 10px 10px 0 10px;
    flex-direction: column;
    align-items: center;
    width: auto;
    height: auto;

    opacity: 1;
    translate: 0 0;
    scale: 1 1;
    transition-property: translate, scale, opacity;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.panel.driven {
    transition-property: opacity;
}

.closed #Background {
    opacity: 0;
}

.closed .panel {
    opacity: 0;
    scale: 0.8 0.8;
    translate: 0 20px;
}

.p-text {
    -unity-text-align: middle-center;
    font-size: 30px;
    -unity-font-definition: url("project://database/Assets/Assets/UIAssets/Font/Nunito/static/Nunito-Regular.ttf?fileID=12800000&guid=17592a853c084e34ca51c3136eb2c6bf&type=3#Nunito-Regular");
}

.button {
    width: 300px;
    height: 70px;
    border-radius: 35px;
    background-color: rgba(255, 255, 255, 0.4);
    margin: 0 0 10px 0;
    transition-property: background-color, height, width, border-radius;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.button:hover {
    background-color: rgba(255, 255, 255, 0.6);
    height: 80px;
    width: 330px;
    border-radius: 40px;
}

.locked .button:hover {
    background-color: rgba(255, 255, 255, 0.4);
    width: 300px;
    height: 70px;
    border-radius: 35px;
}