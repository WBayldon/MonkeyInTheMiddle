/* General Selectors */
.centered {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: center;
}

/* Main Background */
#Background {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.4);
}

/* Button Holders */
.panel {
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 45px;
    padding: 10px 10px 0 10px;
    flex-direction: column;
    align-items: center;
    width: auto;
    height: auto;
}

/* Buttons */
.button {
    width: 300px;
    height: 70px;
    border-radius: 35px;
    background-color: rgba(255, 255, 255, 0.4);
    margin: 0 0 10px 0;

    -unity-text-align: middle-center;

    font-size: 30px;
    -unity-font-definition: url("project://database/Assets/Assets/UIAssets/Font/Nunito/static/Nunito-Regular.ttf");

    transition-property: background-color, height, width, border-radius;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.button:hover {
    background-color: rgba(255, 255, 255, 0.6);
    height: 80px;
    width: 330px;
    border-radius: 40px;
}