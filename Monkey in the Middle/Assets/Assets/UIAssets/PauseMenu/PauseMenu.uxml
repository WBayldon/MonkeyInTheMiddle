<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Assets/UIAssets/PauseMenu/PauseMenu.uss?fileID=7433441132597879392&amp;guid=710adb9821848764f8d4efdc7e75314f&amp;type=3#PauseMenu"/>
    <ui:VisualElement name="Root" class="centered">
        <ui:VisualElement name="Background" style="display: none;"/>
        <ui:VisualElement name="MainPause" class="panel" style="display: none;">
            <ui:Label text="Paused" name="MenuName" class="p-text"/>
            <ui:Button text="Resume" name="ResumeButton" class="button p-text"/>
            <ui:Button text="Unstuck" name="UnstuckButton" class="button p-text"/>
            <ui:Button text="Level Select" name="LevelSelectButton" class="button p-text"/>
            <ui:Button text="Quit Game" name="QuitGameButton" class="button p-text"/>
        </ui:VisualElement>
        <ui:VisualElement name="LevelSelect" class="panel" style="display: none;">
            <ui:Label text="Level Select" name="MenuName" class="p-text"/>
            <ui:Button text="Level 1" name="Level1Button" class="button p-text"/>
            <ui:Button text="Level 2" name="Level2Button" class="button p-text"/>
            <ui:Button text="Level 3" name="Level3Button" class="button p-text"/>
            <ui:Button text="Back" name="BackButton" class="button p-text"/>
        </ui:VisualElement>
        <ui:VisualElement name="Win" class="panel" style="display: flex;">
            <ui:Label text="You Win!" name="MenuName" class="p-text"/>
            <ui:Button text="Restart" name="UnstuckButton" class="button p-text"/>
            <ui:Button text="Next Level" name="NextLevelButton" class="button p-text"/>
            <ui:Button text="Level Select" name="LevelSelectButton" class="button p-text"/>
            <ui:Button text="Quit" name="QuitGameButton" class="button p-text">
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>