<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Assets/UIAssets/CoreStylesheet.uss?fileID=7433441132597879392&amp;guid=710adb9821848764f8d4efdc7e75314f&amp;type=3#CoreStylesheet"/>
    <ui:VisualElement name="Root" class="centered" style="display: flex; align-content: center; left: auto; top: auto; translate: 0% 0%;">
        <ui:VisualElement name="Background" style="display: none;"/>
        <ui:VisualElement name="MainPause" class="panel centered" style="top: auto; left: auto; display: none;">
            <ui:Label text="Paused" name="MenuName" class="p-text"/>
            <ui:Button text="Resume" name="ResumeButton" class="button p-text"/>
            <ui:Button text="Unstuck" name="UnstuckButton" class="button p-text"/>
            <ui:Button text="Level Select" name="LevelSelectButton" class="button p-text"/>
            <ui:Button text="Main Menu" name="MainMenuButton" class="button p-text"/>
        </ui:VisualElement>
        <ui:VisualElement name="LevelSelect" class="panel centered" style="display: none; top: auto; left: auto;">
            <ui:Label text="Level Select" name="MenuName" class="p-text"/>
            <ui:Button text="Level 1" name="Level1Button" class="button p-text"/>
            <ui:Button text="Level 2" name="Level2Button" class="button p-text"/>
            <ui:Button text="Level 3" name="Level3Button" class="button p-text"/>
            <ui:Button text="Level 4" name="Level4Button" class="button p-text"/>
            <ui:Button text="Level 5" name="Level5Button" class="button p-text"/>
            <ui:Button text="Level 6" name="Level6Button" class="button p-text"/>
            <ui:Button text="Level 7" name="Level7Button" class="button p-text"/>
            <ui:Button text="Level 8" name="Level8Button" class="button p-text"/>
            <ui:Button text="Back" name="BackButton" class="button p-text"/>
        </ui:VisualElement>
        <ui:VisualElement name="Win" class="panel centered" style="display: none; left: auto; top: auto;">
            <ui:Label text="You Win!" name="MenuName" class="p-text"/>
            <ui:Button text="Next Level" name="NextLevelButton" class="button p-text"/>
            <ui:Button text="Level Select" name="LevelSelectButton" class="button p-text"/>
            <ui:Button text="Restart" name="UnstuckButton" class="button p-text"/>
            <ui:Button text="Main Menu" name="MainMenuButton" class="button p-text"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
